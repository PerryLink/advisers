{
  "name": "advisers-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Advisers: a staff of AI advisers built on cordis.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
