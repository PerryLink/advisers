    "verify:office": "node scripts/verify-office.mjs",
    "release": "node scripts/release.mjs",
    "test:security": "node scripts/security-suite.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
