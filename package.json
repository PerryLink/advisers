{
  "name": "advisers-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Advisers: a staff of AI advisers built on cordis.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "demo": "node --experimental-strip-types examples/demo.ts",
    "verify:office": "node scripts/verify-office.mjs",
    "release": "node scripts/release.mjs",
    "set-version": "node scripts/set-version.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:tos": "node scripts/check-tos.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:js": "node scripts/check-js.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:security": "node scripts/security-suite.mjs",
    "test:fault": "node scripts/fault-injection.mjs",
    "eval:det": "node scripts/eval-det.mjs",
    "eval:mail-local": "node eval/run-mail-local-gold.mjs",
    "eval:kb-retrieval": "node eval/kb-retrieval/run.mjs",
    "eval:model-contract": "node eval/model-contract/run.mjs",
    "eval:check-report": "node scripts/check-eval-report.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "sbom": "node scripts/sbom.mjs",
    "check:sbom": "node scripts/check-sbom.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
