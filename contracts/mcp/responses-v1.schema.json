{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PerryLink/advisers/contracts/mcp/responses-v1.schema.json",
  "title": "Advisers MCP stdio responses (contract v1)",
  "description": "Frozen shapes for the JSON-RPC responses of `advisers mcp --stdio`: initialize, tools/list, resources/list, resources/read, tools/call and errors. Every result is one JSON object per stdout line; stderr carries process diagnostics only. The catalogue itself is frozen in tools-v1.json / resources-v1.json. 0.3.0 additive fields: list payloads may carry total/truncated/limit/totals (caps applied after clearance, before the egress classifier). 0.5.0 additive fields: every successful read-tool/read-resource payload may carry a row-level `view` label and one top-level `disclosure` block (documented-additive; older payloads stay valid).",
  "version": 1,
  "x-license": "CC-BY-NC-SA-4.0",
  "x-contract-status": "frozen",
  "x-frozen-at": "2026-11-20",
  "x-source-commit": "35a51c3",
  "x-compat": "additive",
  "$defs": {
    "JsonRpcErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "error"
      ],
      "additionalProperties": true
    },
    "McpTool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "type": "object",
          "description": "JSON Schema for tool arguments (see tools-v1.json).",
          "additionalProperties": true
        },
        "annotations": {
          "type": "object",
          "properties": {
            "readOnlyHint": {
              "type": "boolean"
            },
            "destructiveHint": {
              "type": "boolean"
            },
            "idempotentHint": {
              "type": "boolean"
            },
            "openWorldHint": {
              "type": "boolean"
            }
          },
          "required": [
            "readOnlyHint",
            "destructiveHint",
            "idempotentHint",
            "openWorldHint"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "name",
        "description",
        "inputSchema",
        "annotations"
      ],
      "additionalProperties": true
    },
    "InitializeResult": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "tools": {
                  "type": "object",
                  "properties": {
                    "listChanged": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "listChanged"
                  ],
                  "additionalProperties": true
                },
                "resources": {
                  "type": "object",
                  "properties": {
                    "subscribe": {
                      "type": "boolean"
                    },
                    "listChanged": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "subscribe",
                    "listChanged"
                  ],
                  "additionalProperties": true
                }
              },
              "required": [
                "tools",
                "resources"
              ],
              "additionalProperties": true
            },
            "serverInfo": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "const": "advisers"
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "protocolVersion",
            "capabilities",
            "serverInfo"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true
    },
    "ToolsListResult": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/McpTool"
              },
              "description": "Tools in a stable, deterministic order."
            }
          },
          "required": [
            "tools"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true
    },
    "McpResource": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^advisers://[a-z]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "const": "application/json"
        }
      },
      "required": [
        "uri",
        "name",
        "description",
        "mimeType"
      ],
      "additionalProperties": true
    },
    "ResourcesListResult": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/McpResource"
              }
            }
          },
          "required": [
            "resources"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true
    },
    "ResourceReadResult": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "contents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string",
                    "pattern": "^advisers://[a-z]+$"
                  },
                  "mimeType": {
                    "type": "string",
                    "const": "application/json"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 2,
                    "description": "JSON-encoded payload; the checker parses it and validates the corresponding $defs payload."
                  }
                },
                "required": [
                  "uri",
                  "mimeType",
                  "text"
                ],
                "additionalProperties": true
              },
              "description": "At least one content block.",
              "minItems": 1
            }
          },
          "required": [
            "contents"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true
    },
    "ToolCallResult": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "content": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": true
              },
              "description": "One sanitized text block (pretty-printed JSON payload on success)."
            },
            "isError": {
              "type": "boolean"
            }
          },
          "required": [
            "content",
            "isError"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": true
    },
    "CompactCommitment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "debtor": {
          "type": "string"
        },
        "creditor": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/ReadView"
        }
      },
      "required": [
        "id",
        "debtor",
        "creditor",
        "action"
      ],
      "additionalProperties": true
    },
    "CompactCommitmentRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "creditor": {
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/ReadView"
        }
      },
      "required": [
        "id",
        "status",
        "action",
        "creditor"
      ],
      "additionalProperties": true
    },
    "TodayResource": {
      "type": "object",
      "properties": {
        "open": {
          "type": "integer",
          "description": "Count before truncation."
        },
        "commitments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompactCommitment"
          }
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        }
      },
      "required": [
        "open",
        "commitments",
        "clearance",
        "protectedExcluded"
      ],
      "additionalProperties": true
    },
    "CommitmentsResource": {
      "type": "object",
      "properties": {
        "commitments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompactCommitmentRow"
          }
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        }
      },
      "required": [
        "commitments",
        "clearance",
        "protectedExcluded"
      ],
      "additionalProperties": true
    },
    "WhoResource": {
      "type": "object",
      "properties": {
        "mine": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Commitment rows for the user/agent side.",
            "additionalProperties": true
          }
        },
        "waiting": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Commitment rows for third parties.",
            "additionalProperties": true
          }
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer"
        },
        "mineTotal": {
          "type": "integer",
          "minimum": 0
        },
        "waitingTotal": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        }
      },
      "required": [
        "mine",
        "waiting",
        "clearance",
        "protectedExcluded"
      ],
      "additionalProperties": true
    },
    "EvidenceIndexRow": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "found": {
          "type": "boolean"
        },
        "sources": {
          "type": "integer"
        },
        "missing": {
          "type": "integer"
        },
        "view": {
          "$ref": "#/$defs/ReadView"
        }
      },
      "required": [
        "kind",
        "id",
        "found"
      ],
      "additionalProperties": true
    },
    "EvidenceIndexResource": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "perKind": {
              "type": "integer"
            }
          },
          "required": [
            "perKind"
          ],
          "additionalProperties": true
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer"
        },
        "commitments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceIndexRow"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceIndexRow"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceIndexRow"
          }
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        }
      },
      "required": [
        "limits",
        "clearance",
        "protectedExcluded",
        "commitments",
        "facts",
        "preferences"
      ],
      "additionalProperties": true
    },
    "RemindToolPayload": {
      "type": "object",
      "properties": {
        "reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Reminder rows (same shape as CLI remind --json reminders[]; additive).",
            "additionalProperties": true
          }
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "reminders",
        "clearance",
        "protectedExcluded"
      ],
      "additionalProperties": true
    },
    "EvidenceToolPayload": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 2
        },
        "commitment": {
          "type": "object",
          "description": "Commitment row when the id is cm_*.",
          "additionalProperties": true
        },
        "fact": {
          "type": "object",
          "description": "Fact row when the id is fact_*.",
          "additionalProperties": true
        },
        "preference": {
          "type": "object",
          "description": "Preference row when the id is pref_*.",
          "additionalProperties": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Resolved sources.",
            "additionalProperties": true
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Missing refs.",
            "additionalProperties": true
          }
        },
        "unverifiable": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Unverifiable/operator-entered refs.",
            "additionalProperties": true
          }
        },
        "summary": {
          "type": "object",
          "description": "{byKind,missing,unverifiable,operatorEntered}.",
          "additionalProperties": true
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer"
        },
        "sourcesTotal": {
          "type": "integer",
          "minimum": 0
        },
        "missingTotal": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        }
      },
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "sources",
        "missing",
        "unverifiable",
        "clearance",
        "protectedExcluded"
      ]
    },
    "CaptureCandidatePayload": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "candidate": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "pending"
            }
          },
          "required": [
            "id",
            "kind",
            "status"
          ],
          "additionalProperties": true
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ok",
        "candidate",
        "note"
      ],
      "additionalProperties": true
    },
    "PackVerifyPayload": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fileCount": {
          "type": "integer"
        },
        "receiptPresent": {
          "type": "boolean"
        },
        "extraFileCount": {
          "type": "integer"
        },
        "verifiedAt": {
          "type": "string",
          "minLength": 4
        }
      },
      "required": [
        "ok",
        "errors",
        "files",
        "fileCount",
        "receiptPresent",
        "extraFileCount",
        "verifiedAt"
      ],
      "additionalProperties": true
    },
    "ClientCounts": {
      "type": "object",
      "properties": {
        "matters": {
          "type": "integer",
          "minimum": 0
        },
        "mattersArchived": {
          "type": "integer",
          "minimum": 0
        },
        "deliveries": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "commitments": {
          "type": "integer",
          "minimum": 0
        },
        "openMine": {
          "type": "integer",
          "minimum": 0
        },
        "openWaiting": {
          "type": "integer",
          "minimum": 0
        },
        "overdue": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "matters",
        "mattersArchived",
        "deliveries",
        "notes",
        "commitments",
        "openMine",
        "openWaiting",
        "overdue"
      ],
      "additionalProperties": false
    },
    "NextDueAt": {
      "description": "Earliest open due date as an ISO-8601 string, or null when nothing is due.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ClientRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrecyDefault": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counts": {
          "$ref": "#/$defs/ClientCounts"
        },
        "nextDueAt": {
          "$ref": "#/$defs/NextDueAt"
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer",
          "minimum": 0
        },
        "view": {
          "$ref": "#/$defs/ReadView"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "aliases",
        "secrecyDefault",
        "tags",
        "counts",
        "nextDueAt",
        "clearance",
        "protectedExcluded"
      ],
      "additionalProperties": false
    },
    "ClientsResource": {
      "type": "object",
      "properties": {
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientRow"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer",
          "minimum": 0
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        }
      },
      "required": [
        "clients",
        "total",
        "truncated",
        "limit",
        "clearance",
        "protectedExcluded"
      ],
      "additionalProperties": false
    },
    "ClientIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrecyDefault": {
          "type": "integer",
          "minimum": 0
        },
        "view": {
          "$ref": "#/$defs/ReadView"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "aliases",
        "tags",
        "secrecyDefault"
      ],
      "additionalProperties": false
    },
    "ClientProject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/ClientCounts"
        },
        "nextDueAt": {
          "$ref": "#/$defs/NextDueAt"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "counts",
        "nextDueAt"
      ],
      "additionalProperties": false
    },
    "ClientOpenRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "debtor": {
          "type": "string"
        },
        "creditor": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "dueAt": {
          "type": "string"
        },
        "matterId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "secrecy": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "action",
        "debtor",
        "creditor",
        "status",
        "secrecy"
      ],
      "additionalProperties": false
    },
    "ClientOpen": {
      "type": "object",
      "properties": {
        "mine": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientOpenRow"
          }
        },
        "waiting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientOpenRow"
          }
        },
        "mineTotal": {
          "type": "integer",
          "minimum": 0
        },
        "waitingTotal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mine",
        "waiting",
        "mineTotal",
        "waitingTotal"
      ],
      "additionalProperties": false
    },
    "ClientTimelineItem": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "delivery",
            "commitment"
          ]
        },
        "title": {
          "type": "string"
        },
        "ref": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "delivery",
                "commitment"
              ]
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "matterId": {
          "type": "string"
        },
        "secrecy": {
          "type": "integer"
        }
      },
      "required": [
        "at",
        "kind",
        "title",
        "ref",
        "matterId",
        "secrecy"
      ],
      "additionalProperties": false
    },
    "ClientStatusResource": {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientIdentity"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientProject"
          }
        },
        "counts": {
          "$ref": "#/$defs/ClientCounts"
        },
        "open": {
          "$ref": "#/$defs/ClientOpen"
        },
        "nextDueAt": {
          "$ref": "#/$defs/NextDueAt"
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientTimelineItem"
          }
        },
        "timelineTotal": {
          "type": "integer",
          "minimum": 0
        },
        "timelineTruncated": {
          "type": "boolean"
        },
        "clearance": {
          "type": "integer"
        },
        "protectedExcluded": {
          "type": "integer",
          "minimum": 0
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        }
      },
      "required": [
        "client",
        "projects",
        "counts",
        "open",
        "nextDueAt",
        "timeline",
        "timelineTotal",
        "timelineTruncated",
        "clearance",
        "protectedExcluded"
      ],
      "additionalProperties": false
    },
    "ClientsToolPayload": {
      "description": "advisers_clients result: a list payload (action=list) or one client status payload (action=show).",
      "oneOf": [
        {
          "$ref": "#/$defs/ClientsResource"
        },
        {
          "$ref": "#/$defs/ClientStatusResource"
        }
      ]
    },
    "ReadView": {
      "type": "string",
      "description": "Row-level read view: 'verified' = a local evidence pointer resolved, 'pending' = current record without a resolved local pointer, 'historical' = no longer current (done/dropped/superseded/deprecated), 'derived' = computed projection (clients). 'verified' never means the record is true.",
      "enum": [
        "verified",
        "pending",
        "historical",
        "derived"
      ]
    },
    "DisclosureViewCounts": {
      "type": "object",
      "description": "Counts of the returned rows per view label (rows withheld by clearance or truncation are not counted here; see protectedExcluded/truncated).",
      "properties": {
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "historical": {
          "type": "integer",
          "minimum": 0
        },
        "derived": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "verified",
        "pending",
        "historical",
        "derived"
      ],
      "additionalProperties": false
    },
    "Disclosure": {
      "type": "object",
      "description": "Additive 0.5.0 read disclosure: metadata only (field names, view counts, clearance, disclosure digest). It never embeds record values, quotes, paths or timestamps. callId/digest are content-addressed over this metadata, so the same read shape yields the same ids in both eras.",
      "properties": {
        "surface": {
          "type": "string",
          "description": "Disclosure surface; this contract covers the MCP surface (the DSH adapter emits the same shape with surface 'dsh' and audited=false).",
          "enum": [
            "mcp"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "Tool name, or advisers:// resource URI for a resource read."
        },
        "basis": {
          "type": "string",
          "enum": [
            "local-resolution",
            "preview"
          ],
          "description": "Verification basis: 'local-resolution' reads the local ledger; 'preview' is the marked no-ledger fallback."
        },
        "callId": {
          "type": "string",
          "pattern": "^dc_[0-9a-f]{16}$",
          "description": "Content-addressed disclosure id (sha256 of the disclosure metadata, first 16 hex)."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sorted names of the record fields that were returned (no values)."
        },
        "view": {
          "$ref": "#/$defs/DisclosureViewCounts"
        },
        "clearance": {
          "type": "integer",
          "minimum": 0
        },
        "protectedExcluded": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "audited": {
          "type": "boolean",
          "description": "True when the single mcp.call audit row for this read was written; false (with warning) when no local audit sink is available."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "sha256 over the canonical disclosure metadata (not over record values)."
        },
        "warning": {
          "type": "string",
          "minLength": 1,
          "description": "Present only when audited=false (e.g. no audit sink configured)."
        }
      },
      "required": [
        "surface",
        "tool",
        "basis",
        "callId",
        "fields",
        "view",
        "clearance",
        "protectedExcluded",
        "truncated",
        "audited",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
