    {
      "id": "tools-list.valid",
      "target": "#/$defs/ToolsListResult",
      "expect": "accept",
      "value": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "tools": [
            {
              "name": "advisers_today",
              "description": "Read the open-commitment count and the open commitments (read-only). Records belonging to protected matters (matter secrecy above this server clearance, default 0) are excluded and only counted in protectedExcluded.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              }
            },
            {
              "name": "advisers_commit_ls",
              "description": "List commitments (open by default; pass all=true for every status). Returns {commitments, clearance, protectedExcluded}. Read-only. Records belonging to protected matters (matter secrecy above this server clearance, default 0) are excluded and only counted in protectedExcluded.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "all": {
                    "type": "boolean",
                    "description": "Include done/snoozed/dropped commitments."
                  }
                }
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              }
            },
            {
              "name": "advisers_who",
              "description": "Who owes whom: mine (user/agent) versus waiting (third parties). Read-only. Records belonging to protected matters (matter secrecy above this server clearance, default 0) are excluded and only counted in protectedExcluded.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              }
            },
            {
              "name": "advisers_evidence",
              "description": "Read the source turns for a commitment/fact/preference id. Read-only. Evidence of a protected record is withheld (no id content) and reported as protectedExcluded.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "cm_* commitment, fact_* fact, or pref_* preference id."
                  }
                },
                "required": [
                  "id"
                ]
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              }
            },
            {
              "name": "advisers_remind",
              "description": "Read due reminders (no delivery, no network). Returns {reminders, clearance, protectedExcluded}. Read-only. Records belonging to protected matters (matter secrecy above this server clearance, default 0) are excluded and only counted in protectedExcluded.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              }
            },
            {
              "name": "advisers_capture_candidate",
              "description": "Propose a PENDING commitment candidate captured from a quote. This writes a memory candidate only: it never accepts the candidate and never changes the ledger. A human must review it with \"advisers memory candidates\" and run \"advisers memory accept <id>\".",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "What must be done (verbatim or near-verbatim)."
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "The verbatim source text this candidate was captured from."
                  },
                  "debtor": {
                    "type": "string",
                    "enum": [
                      "user",
                      "agent",
                      "third"
                    ],
                    "description": "Who owes the action. Defaults to user."
                  },
                  "creditor": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Who is owed the action. Defaults to someone."
                  },
                  "dueAt": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "ISO 8601 due date-time, e.g. 2026-12-01T10:00:00+08:00."
                  },
                  "matterId": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "Existing matter id. Defaults to the first active matter."
                  }
                },
                "required": [
                  "action",
                  "quote"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
              }
            },
            {
              "name": "advisers_pack_verify",
              "description": "Read-only verification of an evidence-pack receipt directory: recomputes SHA256SUMS for manifest.json and README.txt, rejects unsafe or unhashed pack files, and reports whether a receipt.docx is present. Never modifies the directory. The directory path is not echoed in errors.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "dir": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "Directory written by \"advisers deliveries --pack\" (contains manifest.json, README.txt, SHA256SUMS, optionally receipt.docx)."
                  }
                },
                "required": [
                  "dir"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              }
            }
          ]
        }
      }
    },
