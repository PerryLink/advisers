{
  "version": 1,
  "schema": "../../mcp/responses-v1.schema.json",
  "description": "Conformance vectors for MCP stdio responses and their JSON payloads. Envelopes and payloads were captured from the real server at the freeze commit and normalized.",
  "covers": [
    "#/$defs/CaptureCandidatePayload",
    "#/$defs/CommitmentsResource",
    "#/$defs/EvidenceIndexResource",
    "#/$defs/EvidenceToolPayload",
    "#/$defs/InitializeResult",
    "#/$defs/JsonRpcErrorResponse",
    "#/$defs/PackVerifyPayload",
    "#/$defs/RemindToolPayload",
    "#/$defs/ResourceReadResult",
    "#/$defs/ResourcesListResult",
    "#/$defs/TodayResource",
    "#/$defs/ToolCallResult",
    "#/$defs/ToolsListResult",
    "#/$defs/WhoResource"
  ],
