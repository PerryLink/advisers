{
  "name": "advisers-bridge-hermes",
  "version": "0.2.0-preview.20",
  "private": false,
  "description": "File-based bridge from Advisers to the Hermes Agent messaging gateway.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "advisers-core": "0.2.0-preview.20"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/advisers.git",
    "directory": "packages/bridge-hermes"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  }
}
