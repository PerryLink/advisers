{
  "name": "advisers-core",
  "version": "0.2.0-preview.12",
  "description": "Core types and runtime for Advisers: matters, scoped ledgers, focus frames, and the Link SPI.",
  "keywords": [
    "advisers",
    "cordis",
    "secretary",
    "memory",
    "commitments",
    "link"
  ],
  "author": "PerryLink contributors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/advisers.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
