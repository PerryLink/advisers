{
  "name": "advisers-office",
  "version": "0.2.0-preview.5",
  "private": false,
  "description": "Office artifact builders for Advisers: DOCX, XLSX, PPTX, Mermaid, and draw.io.",
  "keywords": [
    "advisers",
    "office",
    "docx",
    "xlsx",
    "pptx",
    "mermaid",
    "drawio"
  ],
  "author": "PerryLink contributors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/advisers.git",
    "directory": "packages/office"
  },
  "publishConfig": {
    "access": "public"
  }
}
